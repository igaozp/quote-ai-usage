{
  "name": "quote-ai-usage",
  "version": "0.2.0",
  "private": true,
  "description": "Aggregate Claude Code & Codex CLI today's token usage and push as a 296x152 PNG to a Dot device",
  "type": "module",
  "bin": {
    "quote-ai": "./bin/quote-ai.mjs"
  },
  "scripts": {
    "push": "tsx src/cli.ts push",
    "watch": "tsx src/cli.ts watch",
    "preview": "tsx src/cli.ts preview",
    "preview:open": "tsx src/cli.ts preview --open",
    "dev": "tsx src/cli.ts push",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@resvg/resvg-wasm": "^2.6.2",
    "satori": "^0.26.0",
    "tsx": "^4.19.2"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.2"
  }
}
