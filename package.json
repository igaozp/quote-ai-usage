{
  "name": "quote-ai-usage",
  "version": "0.3.0",
  "private": true,
  "description": "Aggregate Claude Code & Codex CLI today's token usage and push as a 296x152 PNG to a Dot device",
  "type": "module",
  "bin": {
    "quote-ai": "./src/cli.ts"
  },
  "files": [
    "src",
    "assets/fonts/README.md",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "push": "bun src/cli.ts push",
    "watch": "bun src/cli.ts watch",
    "preview": "bun src/cli.ts preview",
    "preview:open": "bun src/cli.ts preview --open",
    "build": "bun build src/cli.ts --target=bun --outdir dist --minify",
    "build:bin": "bun build src/cli.ts --compile --outfile dist/quote-ai",
    "typecheck": "bunx tsc -p tsconfig.json --noEmit"
  },
  "engines": {
    "bun": ">=1.1"
  },
  "dependencies": {
    "@resvg/resvg-wasm": "^2.6.2",
    "satori": "^0.26.0"
  },
  "devDependencies": {
    "@types/bun": "^1.3.0",
    "typescript": "^5.7.2"
  }
}
