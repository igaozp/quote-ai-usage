# Most users do NOT need this file. Run `quote-ai config` once and credentials
# will be stored at ~/.config/quote-ai-usage/config.json (mode 0600).
#
# Env vars listed here override the on-disk config when set, which is useful
# for CI / one-off scripts.

# DOT_API_KEY=your_api_key_here
# DOT_DEVICE_ID=your_device_serial_here
# DOT_API_BASE_URL=https://dot.mindreset.tech

USAGE_TIMEZONE=Asia/Shanghai
USAGE_INTERVAL=30m
USAGE_COOLDOWN=60s
# CLAUDE_HOME=/custom/path/to/.claude
# CODEX_HOME=/custom/path/to/.codex
# DEBUG_PNG=preview.png
# QUOTE_AI_CACHE=/custom/cache/dir
